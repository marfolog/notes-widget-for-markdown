<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug builds run on emulators and test phones. Their taps would land in the same Analytics
      property as real use, so collection is switched off for good here, whatever the consent says.
      Crash reporting stays as it is.
    -->
    <application>
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
    </application>

</manifest>
